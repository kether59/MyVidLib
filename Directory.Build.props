<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>5</WarningLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Allow restoring/building Windows-targeted projects on non-Windows CI agents -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>5</WarningLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Allow restoring/building Windows-targeted projects on non-Windows CI agents -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Do not fail builds on transitive NuGet security advisories (NU1902/NU1903) for packages not directly versioned yet (SQLitePCLRaw, System.Security.Cryptography.*). Update versions explicitly in a dedicated maintenance pass. -->
    <WarningsNotAsErrors>NU1902;NU1903</WarningsNotAsErrors>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- WPF projects use net10.0-windows -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'MyVidLib.Wpf'">
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>WinExe</OutputType>
  </PropertyGroup>
</Project>
